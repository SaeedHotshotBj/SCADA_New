SCADA_DB_PATH=./data/scada_new.sqlite3
SCADA_SECRET_KEY=replace-this-with-at-least-32-random-bytes
SCADA_SESSION_TTL_HOURS=12
SCADA_DEMO_TELEMETRY=true
SCADA_ALLOW_ORIGINS=
SCADA_PLC_POLLING_ENABLED=true
# Physical writes are OFF by default. Enable only after electrical/process safety review.
SCADA_PLC_WRITES_ENABLED=false
# Raw telemetry history is stored at the PLC history interval and pruned after this many days.
SCADA_PLC_HISTORY_RETENTION_DAYS=30
